# Строка подключения к PostgreSQL (хост — имя сервиса в docker-compose)
DATABASE_URL=postgresql://postgres:password@postgres_db:5432/my_service_db

# Внешний источник данных
API_URL=https://api.example.com/v1/data

# Внешний приёмник результата
RESULT_URL=https://api.example.com/v1/results

# OpenAI
OPENAI_API_KEY=
MODEL=gpt-4o-mini
PROMPT=Определи тональность отзыва. Ответь строго одним словом: positive, negative или neutral.
TEST_MODE=false
